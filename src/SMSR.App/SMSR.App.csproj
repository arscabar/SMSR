<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\SMSR.ico</ApplicationIcon>
    <Version>1.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SMSR.CSharpAnalysis\SMSR.CSharpAnalysis.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <Content Include="GraphRuntime\*.py;GraphRuntime\*.cjs;GraphRuntime\requirements.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="GraphRuntime\vendor\**\*.py;GraphRuntime\vendor\*.json;GraphRuntime\vendor\LICENSE*;GraphRuntime\vendor\NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="WebAssets\*.js;WebAssets\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\artifacts\java-analysis\**\*.class" Link="JavaAnalysis\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\SMSR.png" />
    <Content Include="Assets\SMSR.ico" CopyToOutputDirectory="PreserveNewest" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <Target Name="CopyCSharpAnalyzer" AfterTargets="Build">
    <ItemGroup><CSharpAnalyzerFiles Include="..\SMSR.CSharpAnalysis\bin\$(Configuration)\net10.0\**\*" /></ItemGroup>
    <Copy SourceFiles="@(CSharpAnalyzerFiles)" DestinationFiles="@(CSharpAnalyzerFiles->'$(OutDir)CSharpAnalysis\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishCSharpAnalyzer" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <CSharpPublishFiles Include="..\SMSR.CSharpAnalysis\bin\$(Configuration)\net10.0\**\*" />
      <ResolvedFileToPublish Include="@(CSharpPublishFiles)">
        <RelativePath>CSharpAnalysis\%(CSharpPublishFiles.RecursiveDir)%(CSharpPublishFiles.Filename)%(CSharpPublishFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
