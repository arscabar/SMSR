<UserControl x:Class="SMSR.App.Views.SettingsPetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,14,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="작업 펫" />
            <CheckBox Margin="0,14,0,0" IsChecked="{Binding PetEnabled}" Content="펫 표시" />
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="이름" />
            <TextBox MaxLength="40" Text="{Binding PetName, UpdateSourceTrigger=LostFocus}" />
            <Grid Margin="0,12,0,5">
                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="크기" />
                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding PetSizeLabel}" />
            </Grid>
            <Slider Minimum="60" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True"
                    Value="{Binding PetSizePercent, UpdateSourceTrigger=PropertyChanged, Delay=180}" />
            <TextBlock Margin="0,12,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="진행률별 미디어" />
            <Grid Height="38" Margin="2,0,2,7">
                <Border Height="12" VerticalAlignment="Center" Background="{DynamicResource QuietBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" />
                <Canvas x:Name="BoundaryCanvas" Background="Transparent" Cursor="SizeWE"
                        SizeChanged="BoundaryCanvas_SizeChanged" MouseLeftButtonDown="BoundaryCanvas_MouseLeftButtonDown"
                        MouseMove="BoundaryCanvas_MouseMove" MouseLeftButtonUp="BoundaryCanvas_MouseLeftButtonUp" />
            </Grid>
            <ListBox ItemsSource="{Binding PetMediaRules}" SelectedItem="{Binding SelectedPetMediaRule}"
                     MinHeight="82" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="2" /><Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Segment" Padding="10" Background="{DynamicResource QuietBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Segment" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource QuietHoverBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel>
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="{Binding RangeLabel}" />
                    <TextBlock Margin="0,7,0,0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MediaPath}" />
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,12,0,0">
                <Button Command="{Binding RegisterPetCommand}" Content="미디어 추가" />
                <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Command="{Binding RemovePetMediaRuleCommand}" Content="선택 삭제" />
                <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Command="{Binding RemovePetCommand}" Content="전체 해제" />
            </WrapPanel>
            <Grid Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="완료 후 대기 미디어" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding IdlePetMediaName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Command="{Binding RegisterIdlePetCommand}" Content="선택" />
                    <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                            Command="{Binding RemoveIdlePetCommand}" Content="해제" />
                </WrapPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
