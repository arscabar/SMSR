<UserControl x:Class="SMSR.App.Views.SettingsPetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,14,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="작업 펫" />
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="사용자가 등록한 한 마리가 작업 현황에서 선택한 그래프의 상태를 표시합니다." TextWrapping="Wrap" />
            <CheckBox Margin="0,14,0,0" IsChecked="{Binding PetEnabled}" Content="펫 표시" />
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="이름" />
            <TextBox MaxLength="40" Text="{Binding PetName, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="등록 이미지" />
            <TextBlock Margin="0,4,0,0" Text="{Binding PetImageLabel}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,12,0,0">
                <Button Command="{Binding RegisterPetCommand}" Content="이미지 등록·교체" />
                <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Command="{Binding RemovePetCommand}" Content="등록 해제" />
            </WrapPanel>
            <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="10MB 이하 PNG, JPG, BMP만 허용합니다. 원본 대신 SMSR 데이터 폴더의 안전한 복사본을 사용합니다." TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
