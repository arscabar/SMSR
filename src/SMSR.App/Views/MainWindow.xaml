<Window x:Class="SMSR.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SMSR.App.Views"
        Title="Show Me Status Report" Height="760" Width="840" MinHeight="650" MinWidth="720" WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="52" Height="52" Background="{StaticResource AccentBrush}" CornerRadius="16">
                <Grid Margin="13"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="13" VerticalAlignment="Bottom" Fill="White" RadiusX="2" RadiusY="2" />
                    <Rectangle Grid.Column="1" Height="22" Margin="3,0" VerticalAlignment="Bottom" Fill="White" RadiusX="2" RadiusY="2" />
                    <Rectangle Grid.Column="2" Height="30" VerticalAlignment="Bottom" Fill="White" RadiusX="2" RadiusY="2" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Show Me Status Report" />
                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Codex workflow monitor" />
            </StackPanel>
            <Button Grid.Column="3" Style="{StaticResource QuietButton}" Command="{Binding ExitCommand}" Content="완전 종료" />
        </Grid>
        <TabControl Grid.Row="2">
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" Text="▦" /><TextBlock Text="작업 현황" /></StackPanel></TabItem.Header>
                <views:WorkflowPanel Margin="0,18,0,0" DataContext="{Binding Workspace}" />
            </TabItem>
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" Text="⚙" /><TextBlock Text="서버 · 연결" /></StackPanel></TabItem.Header>
                <views:ServerPanel Margin="0,18,0,0" DataContext="{Binding Server}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
