<Window x:Class="SMSR.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SMSR.App.Views"
        Title="Show Me Status Report" Icon="/Assets/SMSR.png" Height="760" Width="840" MinHeight="650" MinWidth="720" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" /></shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <Image Width="20" Height="20" Margin="10" Source="/Assets/SMSR.png" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Show Me Status Report" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                <Button Grid.Column="2" Margin="4" Style="{StaticResource QuietButton}" Command="{Binding ExitCommand}" Content="완전 종료" />
                <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click" Content="—" />
                <Button Grid.Column="4" Style="{StaticResource ChromeButton}" Click="CloseButton_Click" Content="×" />
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Margin="32,20,32,32">
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" Text="▦" /><TextBlock Text="작업 현황" /></StackPanel></TabItem.Header>
                <views:WorkflowPanel Margin="0,18,0,0" DataContext="{Binding Workspace}" />
            </TabItem>
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" Text="◷" /><TextBlock Text="이벤트 · 요약" /></StackPanel></TabItem.Header>
                <views:WorkflowHistoryPanel Margin="0,18,0,0" DataContext="{Binding Workspace}" />
            </TabItem>
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" Text="⚙" /><TextBlock Text="서버 · 연결" /></StackPanel></TabItem.Header>
                <views:ServerPanel Margin="0,18,0,0" DataContext="{Binding Server}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
