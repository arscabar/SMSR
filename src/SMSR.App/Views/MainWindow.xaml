<Window x:Class="SMSR.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SMSR.App.Views"
        Title="SMSR" Height="780" Width="760" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="SMSR" />
            <TextBlock Margin="0,4,0,20" Foreground="{StaticResource MutedTextBrush}" Text="로컬 MCP 작업 관제" />
            <views:ServerPanel DataContext="{Binding Server}" />
            <views:WorkflowPanel Margin="0,16,0,0" DataContext="{Binding Workspace}" />
        </StackPanel>
    </ScrollViewer>
</Window>
