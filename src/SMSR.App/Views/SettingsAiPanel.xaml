<UserControl x:Class="SMSR.App.Views.SettingsAiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,14,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="AI 작업 요약" />
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding GeminiKeyLabel}" TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,12" Foreground="{DynamicResource MutedTextBrush}" Text="키는 Windows 현재 사용자 DPAPI로 암호화됩니다. Gemini가 없거나 응답하지 않을 때만 Codex에 요약 요청을 엽니다." TextWrapping="Wrap" />
            <PasswordBox x:Name="GeminiApiKey" Height="38" Padding="10,7" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" PasswordChar="●" />
            <WrapPanel Margin="0,12,0,0">
                <Button Click="SaveButton_Click" Content="저장 및 연결 확인" />
                <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Click="TestButton_Click" Content="연결 확인" />
                <Button Margin="8,0,0,0" Style="{StaticResource DangerButton}" Click="DeleteButton_Click" Content="키 삭제" />
            </WrapPanel>
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" Text="{Binding GeminiStatus}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
