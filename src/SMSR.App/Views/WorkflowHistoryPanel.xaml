<UserControl x:Class="SMSR.App.Views.WorkflowHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="0,0,8,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="일자별 작업 요약" />
                <TextBlock Margin="0,5,0,14" Foreground="{DynamicResource MutedTextBrush}" Text="모든 프로젝트의 그래프와 완료 기록을 모아 Gemini로 요약합니다. Gemini를 사용할 수 없을 때만 Codex 요청을 엽니다." TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Command="{Binding GenerateTodaySummaryCommand}" Content="금일 작업 요약" />
                    <Button Margin="8,0,0,0" Command="{Binding GenerateSelectedDateSummaryCommand}" Content="그리드 선택일자 전체 요약" />
                </WrapPanel>
                <Border Margin="0,18,0,0" Padding="16" MinHeight="260" Background="{DynamicResource QuietBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding DailySummaryMeta}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,14,0,0" Text="{Binding DailySummary}" TextWrapping="Wrap" LineHeight="23" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
