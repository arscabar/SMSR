<UserControl x:Class="SMSR.App.Views.WorkflowHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="최근 이벤트" />
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Monitor.RecentEvents}">
                <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,6" Padding="10" Background="#F8FAFD" CornerRadius="6"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" /></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="요약" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Monitor.Summary}" TextWrapping="Wrap" />
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                <Button Width="120" Command="{Binding GenerateSummaryCommand}" Content="요약 생성" />
                <Button Margin="8,0,0,0" Width="120" Command="{Binding ExportCommand}" Content="내보내기" />
            </StackPanel>
            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
