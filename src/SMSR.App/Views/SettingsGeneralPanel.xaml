<UserControl x:Class="SMSR.App.Views.SettingsGeneralPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="일반" />
            <CheckBox Margin="0,16,0,0" IsChecked="{Binding AutomateCodexIntegration}" Content="앱 시작 시 Codex 연결·추적 설정 자동 복구" />
            <CheckBox Margin="0,12,0,0" IsChecked="{Binding StartWithWindows}" Content="Windows 로그인 시 SMSR 자동 시작" />
            <CheckBox Margin="0,12,0,0" IsChecked="{Binding StartServerAutomatically}" Content="SMSR 시작 시 로컬 서버 자동 시작" />
            <CheckBox Margin="0,12,0,0" IsChecked="{Binding MinimizeToTray}" Content="닫기 버튼을 누르면 트레이로 숨기기" />
            <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="대시보드 테마" />
            <ComboBox Width="180" Margin="0,6,0,0" HorizontalAlignment="Left"
                      ItemsSource="{Binding DashboardThemeOptions}"
                      SelectedItem="{Binding DashboardTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="앱과 웹 대시보드 테마는 즉시 적용됩니다. Windows 자동 시작은 현재 실행 파일 경로를 사용하므로 다른 PC에서도 그 PC의 설치 위치로 다시 설정됩니다." TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
