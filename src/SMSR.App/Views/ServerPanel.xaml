<UserControl x:Class="SMSR.App.Views.ServerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Border Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="로컬 서버" />
            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding ServerStatus}" />
            <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="서버 주소" />
            <TextBlock Margin="0,4,0,0" FontFamily="Consolas" Text="{Binding ServerAddress}" />
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="MCP endpoint" />
            <TextBlock Margin="0,4,0,0" FontFamily="Consolas" Text="{Binding McpEndpoint}" />
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Command="{Binding StartCommand}" Content="▶" ToolTip="서버 시작" />
                <Button Margin="8,0,0,0" Style="{StaticResource IconButton}" Command="{Binding StopCommand}" Content="■" ToolTip="서버 중지" />
            </StackPanel>
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <StackPanel Visibility="{Binding NeedsCodexSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Separator Margin="0,18,0,14" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CodexConnectionTitle}" />
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}"
                           Text="앱 시작 시 서버, Windows 자동 시작, Codex OAuth MCP와 전역 자동 추적 훅을 자동 구성합니다. 처음에 OAuth와 훅 신뢰만 한 번 승인하세요."
                           TextWrapping="Wrap" />
                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding SetupConnectionCommand}"
                        Content="연결·자동 추적 지금 복구" />
                <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding CodexStatus}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsCodexConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Separator Margin="0,18,0,14" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding CodexConnectionTitle}" />
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="실제 MCP 요청이 확인되었습니다. 새 작업은 별도 요청 없이 계획·heartbeat·상태를 자동 추적합니다." TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
