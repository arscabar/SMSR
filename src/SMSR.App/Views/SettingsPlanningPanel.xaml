<UserControl x:Class="SMSR.App.Views.SettingsPlanningPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,14,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="SemiBold" Text="작업계획서" />
                <Button DockPanel.Dock="Right" Height="30" Style="{StaticResource QuietButton}"
                        Command="{Binding ResetPlanningPromptCommand}" Content="기본값 복원" />
            </DockPanel>
            <CheckBox Margin="0,16,0,0" IsChecked="{Binding RequirePlanReview}"
                      Content="구현 전에 작업계획서를 보여주고 검토·승인받기" />
            <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource MutedTextBrush}"
                       Text="작업계획서 생성 프롬프트" />
            <TextBox Margin="0,6,0,0" Height="Auto" MinHeight="150" MaxLength="6000"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Text="{Binding PlanningPrompt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="{}{projectId}, {taskId} 변수를 사용할 수 있습니다. 저장된 문구는 새 사용자 요청부터 Codex에 전달되며 SMSR 데이터베이스에는 기록되지 않습니다." />
        </StackPanel>
    </Border>
</UserControl>
