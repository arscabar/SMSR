<UserControl x:Class="SMSR.App.Views.WorkflowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <Border Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="워크플로우 선택" />
                    <TextBlock Margin="0,16,0,6" Text="프로젝트 ID" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Selection.ProjectIds}" Text="{Binding Selection.ProjectId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,12,0,6" Text="워크플로우" />
                    <ComboBox ItemsSource="{Binding Selection.Workflows}" SelectedValuePath="WorkflowId" SelectedValue="{Binding Selection.WorkflowId, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding WorkflowId}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Command="{Binding RefreshSelectionCommand}" Content="목록 새로 고침" />
                        <Button Margin="8,0,0,0" Command="{Binding RefreshMonitorCommand}" Content="상태 새로 고침" />
                        <Button Margin="8,0,0,0" Style="{StaticResource IconButton}" Command="{Binding OpenDashboardCommand}" Content="↗" ToolTip="대시보드 열기" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="작업 캘린더" />
                    <TextBlock Margin="0,4,0,14" Foreground="{DynamicResource MutedTextBrush}" Text="모든 프로젝트의 SMSR 수신 날짜를 한곳에서 찾습니다. 항목을 선택하면 해당 프로젝트와 그래프로 전환됩니다." TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Calendar SelectedDate="{Binding Selection.SelectedDate, Mode=TwoWay}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
                            <Calendar.Resources>
                                <Style TargetType="{x:Type CalendarDayButton}">
                                    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource QuietBrush}" /></Trigger>
                                        <Trigger Property="IsToday" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Trigger>
                                        <Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="{x:Type CalendarButton}"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
                            </Calendar.Resources>
                        </Calendar>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Selection.CalendarSummary}" />
                            <ListView Margin="0,10,0,0" MaxHeight="250" ItemsSource="{Binding Selection.CalendarWorkflows}" SelectedItem="{Binding Selection.SelectedCalendarWorkflow, Mode=TwoWay}">
                                <ListView.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding WorkflowId}">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding CalendarMeta}" TextWrapping="Wrap" />
                                </StackPanel></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="현재 상태" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Monitor.UpdateMode}" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Monitor.Nodes}">
                        <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,6" Padding="10" Background="{DynamicResource QuietBrush}" CornerRadius="6">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NodeId}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Status}" /><TextBlock Grid.Column="2" Text="{Binding AgentId}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,16" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="기록 관리" />
                    <TextBlock Margin="0,4,0,12" Foreground="{DynamicResource MutedTextBrush}" Text="삭제 전 확인창이 표시됩니다. 내보낸 ZIP/HTML과 앱 설정은 삭제하지 않습니다." TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteWorkflowCommand}" Content="선택 작업 삭제" />
                        <Button Margin="8,0,0,0" Style="{StaticResource DangerButton}" Command="{Binding DeleteProjectCommand}" Content="현재 프로젝트 삭제" />
                        <Button Margin="8,0,0,0" Style="{StaticResource DangerButton}" Command="{Binding DeleteAllCommand}" Content="전체 기록 삭제" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
