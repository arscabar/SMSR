<UserControl x:Class="SMSR.App.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SMSR.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <views:SettingsGeneralPanel />
            <views:SettingsPlanningPanel />
            <views:SettingsAiPanel />
            <Border Margin="0,14,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="앱 업데이트" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding CurrentVersionLabel}" />
                    <TextBlock Margin="0,5,0,12" Foreground="{DynamicResource MutedTextBrush}" Text="자동 업데이트를 켜면 시작 시 정식 GitHub 릴리스를 확인하고 SHA-256 검증 후 자동 설치합니다." TextWrapping="Wrap" />
                    <Button Width="130" HorizontalAlignment="Left" Command="{Binding CheckForUpdatesCommand}" Content="업데이트 확인" />
                </StackPanel>
            </Border>
            <Border Margin="0,14,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="로컬 데이터" />
                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="데이터 폴더" />
                    <TextBlock Margin="0,4,0,0" FontFamily="Consolas" Text="{Binding DataPath}" TextWrapping="Wrap" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Command="{Binding OpenDataFolderCommand}" Content="데이터 폴더 열기" />
                        <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Command="{Binding OpenLogFolderCommand}" Content="로그 폴더 열기" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Margin="0,14,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="MCP" />
                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Codex 연결 방식" />
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding McpConnectionMode}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="내부 로컬 endpoint" />
                    <TextBlock Margin="0,4,0,0" FontFamily="Consolas" Text="{Binding McpEndpoint}" />
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Codex가 설치된 SMSR 브리지를 직접 실행합니다. 브라우저 인증이나 별도 Codex CLI가 필요 없으며 127.0.0.1에서만 통신합니다." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
