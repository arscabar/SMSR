    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/FlatTheme.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/ComboBoxParts.xaml" />
                <ResourceDictionary Source="Themes/ComboBoxTheme.xaml" />
                <ResourceDictionary Source="Themes/CheckBoxTheme.xaml" />
