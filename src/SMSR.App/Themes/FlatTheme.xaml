<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#F6F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E4E7EF</Color>
    <Color x:Key="TextColor">#20232F</Color>
    <Color x:Key="MutedTextColor">#777D8E</Color>
    <Color x:Key="AccentColor">#5B5CE2</Color>
    <Color x:Key="AccentHoverColor">#4849C5</Color>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECECFF" />
    <SolidColorBrush x:Key="QuietBrush" Color="#ECEEF6" />
    <SolidColorBrush x:Key="QuietHoverBrush" Color="#DEE2EE" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C2414B" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#A9323C" />

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
</ResourceDictionary>
