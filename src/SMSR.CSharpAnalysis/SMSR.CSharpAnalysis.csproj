<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(MSBuildSDKsPath)/../../../LICENSE.txt" Link="SDK-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildSDKsPath)/../../../ThirdPartyNotices.txt" Link="SDK-ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Reuse the installed SDK; no package restore or repository build evaluation. -->
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
</Project>
